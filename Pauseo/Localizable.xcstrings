    "Głód nikotynowy często trwa kilka minut, choć jego przebieg jest różny u różnych osób." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nicotine craving often lasts a few minutes, though it varies from person to person."
